#include <stdio.h>

int main(void)
{
    int month, day;
    int days = 0; 
    int weekday;

    printf("Please enter the month: ");
    scanf("%d", &month);
    printf("Please enter the day: ");
    scanf("%d", &day);

    switch (month - 1) {
        case 11: days = days + 30; 
        case 10: days = days + 31; 
        case 9:  days = days + 30;
        case 8:  days = days + 31; 
        case 7:  days = days + 31; 
        case 6:  days = days + 30;
        case 5:  days = days + 31;  
        case 4:  days = days + 30;
        case 3:  days = days + 31;
        case 2:  days = days + 28; 
        case 1:  days = days + 31;
    }

    days = days + day;  
    weekday = (days - 1 + 3) % 7;

    printf("2025/%d/%d is ", month, day);
    switch (weekday) {
        case 0: printf("Sunday\n"); break;
        case 1: printf("Monday\n"); break;
        case 2: printf("Tuesday\n"); break;
        case 3: printf("Wednesday\n"); break;
        case 4: printf("Thursday\n"); break;
        case 5: printf("Friday\n"); break;
        case 6: printf("Saturday\n"); break;
    }

    return 0;
}
