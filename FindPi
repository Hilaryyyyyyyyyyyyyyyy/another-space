#include <stdio.h>

int main(void)
{
    double pi = 0.0;
    double sign = 1.0; 
    int n = 1;       

    int n1 = 0;   
    int n2 = 0;   
    int n3 = 0;  
    int n4 = 0;   

    printf("Terms      pi\n");

    while (n4 == 0) { 
        pi = pi + sign * 4.0 / (2 * n - 1);
        sign = -sign;

        if (n <= 20)   
            printf("%-10d %.6f\n", n, pi);

        if (n1 == 0 && pi >= 3.14 && pi < 3.15)
            n1 = n;
        if (n2 == 0 && pi >= 3.141 && pi < 3.142)
            n2 = n;
        if (n3 == 0 && pi >= 3.1415 && pi < 3.1416)
            n3 = n;
        if (n4 == 0 && pi >= 3.14159 && pi < 3.1416)
            n4 = n;

        n = n + 1;
    }

    printf("\n3.14    : %d terms\n", n1);
    printf("3.141   : %d terms\n", n2);
    printf("3.1415  : %d terms\n", n3);
    printf("3.14159 : %d terms\n", n4);

    return 0;
}
